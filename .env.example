# Copy to .env.local (never uploaded) and fill in. The phone never sees any of these except NEXT_PUBLIC_ ones.
# Database (server only). The secret key is required; the app refuses to run with the public key.
SUPABASE_URL=https://qujinbsslmyaltfgsjzb.supabase.co
SUPABASE_SECRET_KEY=

# Push notifications (Android and the iPhone Home Screen app). Make a pair once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@telgopowerprojects.com

# The daily 90-day Trash clean-up (Vercel cron sends it). At least 16 random characters.
CRON_SECRET=

# Optional: email login details to new people (SMTP). Without it the admin reads the temporary password off the screen.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
